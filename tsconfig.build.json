{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "drizzle/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules/**",
    ".next/**",
    "tests/**",
    "scripts/**",
    "playwright-report/**",
    "test-results/**",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
