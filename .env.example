# ProjectFlow — environment variable CLASSES
# -------------------------------------------------------------------
# Copy to `.env.local` and fill with NON-PRODUCTION values for local dev.
# NEVER commit real secrets. NEVER put server-only values in NEXT_PUBLIC_*.
# Preview/dev environments MUST NOT hold production credentials (doc 74 §6).
# -------------------------------------------------------------------

# --- Application ---------------------------------------------------
# Public base URL of this deployment (used for auth callbacks / invite links).
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# local | preview | production
APP_ENV="local"

# --- Supabase (client-safe) -----------------------------------------
# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- Supabase (SERVER ONLY — never expose) --------------------------
# Used for migrations, controlled system seeds and admin repair paths only.
# Must never be imported by client components or prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Database (SERVER ONLY) -----------------------------------------
# Pooled connection string used by the app at runtime.
DATABASE_URL=""
# Direct (non-pooled) connection used by drizzle-kit migrations.
DIRECT_DATABASE_URL=""

# Optional: dedicated throwaway database for integration tests.
# When unset, DB integration tests fall back to an in-process PGlite instance.
TEST_DATABASE_URL=""

# --- Storage ---------------------------------------------------------
SUPABASE_STORAGE_BUCKET="documents"
# Bytes. Default 25MB (doc 75 §5).
DOCUMENTS_MAX_UPLOAD_BYTES="26214400"

# --- Email (SERVER ONLY) ---------------------------------------------
# When EMAIL_DRIVER=console (default outside production) nothing is actually sent.
# console | resend
EMAIL_DRIVER="console"
RESEND_API_KEY=""
EMAIL_FROM="ProjectFlow <no-reply@example.com>"

# --- Observability ----------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
# debug | info | warn | error
LOG_LEVEL="info"

# --- Testing ----------------------------------------------------------
PLAYWRIGHT_BASE_URL=""
