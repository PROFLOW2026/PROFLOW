# ProjectFlow — environment variable CLASSES
# -------------------------------------------------------------------
# Copy to `.env.local` and fill with NON-PRODUCTION values for local dev.
# NEVER commit real secrets. NEVER put server-only values in NEXT_PUBLIC_*.
# Preview/dev environments MUST NOT hold production credentials (doc 74 §6).
# -------------------------------------------------------------------

# --- Application ---------------------------------------------------
# Public base URL of this deployment (used for auth callbacks / invite links).
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# local | preview | production
APP_ENV="local"

# --- Supabase (client-safe) -----------------------------------------
# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- Supabase (SERVER ONLY — never expose) --------------------------
# Used for migrations, controlled system seeds and admin repair paths only.
# Must never be imported by client components or prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Database (SERVER ONLY) -----------------------------------------
# Pooled connection string used by the app at runtime.
DATABASE_URL=""
# Direct (non-pooled) connection used by drizzle-kit migrations.
DIRECT_DATABASE_URL=""

# Optional pool size for the runtime postgres client (default 5, max 50).
DATABASE_POOL_MAX="5"

# Optional: dedicated throwaway database for integration tests.
# When unset, DB integration tests fall back to an in-process PGlite instance.
TEST_DATABASE_URL=""

# --- Storage ---------------------------------------------------------
SUPABASE_STORAGE_BUCKET="documents"
# Bytes. Default 25MB (doc 75 §5).
DOCUMENTS_MAX_UPLOAD_BYTES="26214400"

# --- Email (SERVER ONLY) ---------------------------------------------
# When EMAIL_DRIVER=console (default outside production) nothing is actually sent.
# console | resend
EMAIL_DRIVER="console"
RESEND_API_KEY=""
EMAIL_FROM="ProjectFlow <no-reply@example.com>"

# --- Observability ----------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
# debug | info | warn | error
LOG_LEVEL="info"

# --- OCR / document intelligence (SERVER ONLY) -----------------------
# Feature gate — OFF by default. Stub alone is never customer-visible "working OCR".
# Live mode requires OCR_INGESTION_ENABLED=true AND OCR_PROVIDER!=stub with credentials.
OCR_INGESTION_ENABLED="false"
# stub | azure
OCR_PROVIDER="stub"
# When unset, stub/azure return not_configured (no fabricated amounts).
OCR_PROVIDER_API_KEY=""
# Required for OCR_PROVIDER=azure
OCR_PROVIDER_ENDPOINT=""
# Optional model override. Default: prebuilt-receipt for expense workflow,
# prebuilt-invoice for AP / vendor credit / general. One paid model per file.
OCR_PROVIDER_MODEL=""
# Local tooling only — never production. Sample review jobs, not real OCR.
OCR_ALLOW_FIXTURE="false"
# Azure Document Intelligence pricing tier: F0 (default, 4MB/2 pages) or S0.
OCR_AZURE_TIER="F0"
# Paid Query Fields add-on — S0 only, OFF by default. Hebrew does NOT require this.
OCR_AZURE_QUERY_FIELDS="false"
# Durable OCR worker (Vercel cron / operator). Upload only enqueues queued jobs.
# POST /api/internal/ocr-worker with Authorization: Bearer $OCR_WORKER_SECRET
OCR_WORKER_SECRET=""
# Playwright harness only (never set in real deployments):
# OCR_E2E_MOCK_PROVIDER="true"
# E2E_INMEMORY_STORAGE="true"

# --- Webhooks (SERVER ONLY) ------------------------------------------
# 64-char hex or passphrase used to seal webhook signing secrets at rest.
# Required when APP_ENV=production. Local/preview may omit and fall back to
# hashing SUPABASE_SERVICE_ROLE_KEY / DATABASE_URL (never in production).
WEBHOOK_SECRET_KEK=""

# --- Experience preview (SERVER ONLY, optional) -----------------------
# Owner-only cookie preview of another business-profile navigation mix.
# On automatically for APP_ENV=local|preview. Set to 1/true to enable in
# production staging for Owners (never mutates org configuration).
# PF_EXPERIENCE_PREVIEW="1"

# --- Testing ----------------------------------------------------------
PLAYWRIGHT_BASE_URL=""
